{
  "expo": {
    "name": "Terminal Companion",
    "slug": "just-terminal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#202020",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.justsuperhuman.justterminal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Terminal Companion uses the microphone for on-device voice dictation into the command line. Audio is transcribed locally and never leaves your device.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.justsuperhuman.justterminal",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#202020",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#202020",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "@kesha-antonov/react-native-background-downloader",
      "./plugins/withMmkvMemsetFix.js",
      "expo-audio",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Terminal Companion lets you attach photos to remote terminal sessions (for example, pasting a screenshot into Claude or Codex)."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1826b20f-48dc-4b2e-9cd4-4375ff5b80d7"
      }
    }
  }
}
