import "ITerminalConnection.idl";

namespace Microsoft.Terminal.TerminalConnection
{
    delegate void NewConnectionHandler(ConptyConnection connection);

    [default_interface] runtimeclass ConptyConnection : ITerminalConnection
    {
        ConptyConnection();
        String Commandline { get; };
        String StartingTitle { get; };
        UInt16 ShowWindow { get; };

        void ResetSize();
        void ClearBuffer(Boolean keepCursorRow);

        void ShowHide(Boolean show);

        void ReparentWindow(UInt64 newParent);

        UInt64 RootProcessHandle();

        // Push live tab metadata to the terminal-web bridge mirror.
        void UpdateBridgeTitle(String title);
        void SetBridgeProject(String projectId);
        void UpdateBridgeCwd(String cwd);

        // "claude", "codex", or "" — which coding agent is currently running
        // inside this connection's process tree.
        String ForegroundAgent();
        // Live working directory of the deepest child process (the running
        // program), or of the shell itself; "" when it cannot be read.
        String ForegroundWorkingDirectory();

        static event NewConnectionHandler NewConnection;
        static void StartInboundListener();

        // terminal-web bridge introspection: connection state for status UI,
        // and the access token remote clients need to connect.
        static String BridgeConnectionStatus();
        static String BridgeEndpoint();
        static String BridgeAccessToken();
        static void ConfigureBridge(Boolean enabled,
                                    Boolean automaticPort,
                                    UInt16 port,
                                    String bindAddress,
                                    Boolean webInterfaceEnabled);

        static Windows.Foundation.Collections.ValueSet CreateSettings(String cmdline,
                                                                      String startingDirectory,
                                                                      String startingTitle,
                                                                      Boolean reloadEnvironmentVariables,
                                                                      String initialEnvironment,
                                                                      IMapView<String, String> environmentOverrides,
                                                                      UInt32 rows,
                                                                      UInt32 columns,
                                                                      Guid guid,
                                                                      Guid profileGuid);
    };
}
