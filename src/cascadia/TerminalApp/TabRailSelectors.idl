namespace TerminalApp
{
    // Picks the section-header template for TabGroup items and the tab
    // template for everything else in the vertical rail's flat list.
    [default_interface] runtimeclass TabRailItemTemplateSelector : Windows.UI.Xaml.Controls.DataTemplateSelector
    {
        TabRailItemTemplateSelector();

        Windows.UI.Xaml.DataTemplate GroupHeaderTemplate;
        Windows.UI.Xaml.DataTemplate TabTemplate;
    }

    // Header rows get a chrome-less container so they don't look selectable.
    [default_interface] runtimeclass TabRailItemStyleSelector : Windows.UI.Xaml.Controls.StyleSelector
    {
        TabRailItemStyleSelector();

        Windows.UI.Xaml.Style GroupHeaderStyle;
        Windows.UI.Xaml.Style TabStyle;
    }
}
