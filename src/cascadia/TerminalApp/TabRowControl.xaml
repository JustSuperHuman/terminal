<ContentPresenter x:Class="TerminalApp.TabRowControl"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:TerminalApp"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:mtu="using:Microsoft.Terminal.UI"
                  xmlns:mux="using:Microsoft.UI.Xaml.Controls"
                  Background="{ThemeResource TabViewBackground}"
                  mc:Ignorable="d">

    <!--
        GH#13143: Make sure that the Background is actually TabViewBackground
        here, not Transparent. This is load bearing, for showTabsInTitlebar=false.
    -->

    <ContentPresenter.Resources>
        <!--
            Row and header chrome - the selection accent bar, the hover fill,
            the metrics and the type ramp - lives in TabRailStyles.xaml, which
            App.xaml merges. Only the markup that needs x:Bind or an event
            handler is here.
        -->
        <DataTemplate x:Key="TabRailGroupHeaderTemplate"
                      x:DataType="local:TabGroup">
            <!--
                One project section header: a hairline, then a row that is
                itself the collapse toggle. The [+] fades in on hover or
                keyboard focus. Nothing here carries a fill - the accent is
                reserved for "this is the tab you are looking at", and the one
                exception is the marker that says the focused tab is inside
                this folded section.
            -->
            <StackPanel>
                <Border Style="{StaticResource TabRailDividerStyle}"
                        Visibility="{x:Bind ShowDivider, Mode=OneWay}" />
                <Grid Margin="{x:Bind HeaderMargin, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      PointerEntered="OnTabGroupHeaderPointerEntered"
                      PointerExited="OnTabGroupHeaderPointerExited">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                            Click="OnTabGroupHeaderClick"
                            KeyDown="OnTabGroupHeaderKeyDown"
                            Style="{StaticResource TabRailSectionHeaderButtonStyle}">
                        <!--
                            _toggleGroup animates the first FontIcon among this
                            Grid's children, so the chevron has to stay ahead of
                            the folder/repository glyph.
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      AutomationProperties.AccessibilityView="Raw"
                                      Glyph="&#xE70D;"
                                      Style="{StaticResource TabRailSectionGlyphStyle}">
                                <FontIcon.RenderTransform>
                                    <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                            <!--  A checkout reads differently from a plain folder.  -->
                            <FontIcon Grid.Column="1"
                                      Margin="6,0,0,0"
                                      AutomationProperties.AccessibilityView="Raw"
                                      Glyph="{x:Bind SectionGlyph, Mode=OneWay}"
                                      Style="{StaticResource TabRailSectionGlyphStyle}"
                                      Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SectionGlyph), Mode=OneWay}" />
                            <StackPanel Grid.Column="2"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TabRailSectionNameTextBlockStyle}"
                                               Text="{x:Bind Name, Mode=OneWay}" />
                                    <!--  Focused tab is inside this folded section.  -->
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="6,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="{ThemeResource TabRailSelectionAccentBrush}"
                                             Visibility="{x:Bind ActiveMarkerVisibility, Mode=OneWay}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource TabRailSectionPathTextBlockStyle}"
                                               Text="{x:Bind Path, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}"
                                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(Path), Mode=OneWay}" />
                                    <!--
                                        Every tab in one checkout is on the same
                                        branch, so the section says it once here
                                        instead of every row repeating it.
                                    -->
                                    <Border Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource TabRailBranchPillStyle}"
                                            Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(Branch), Mode=OneWay}">
                                        <TextBlock Foreground="{ThemeResource TabRailBranchBrush}"
                                                   Style="{StaticResource TabRailSectionPathTextBlockStyle}"
                                                   Text="{x:Bind Branch, Mode=OneWay}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                            <!--  A tab count is neither urgent nor unread: plain tertiary text, no pill.  -->
                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource TabRailCountTextBlockStyle}"
                                       Text="{x:Bind CountText, Mode=OneWay}" />
                        </Grid>
                    </Button>

                    <!--
                        _setHeaderNewTabButtonOpacity picks this out as the
                        header's only direct Button child with a fixed width -
                        TabRailIconButtonStyle sets one, TabRailSectionHeader-
                        ButtonStyle deliberately leaves Width unset. Keep it
                        that way, on both sides.
                    -->
                    <Button x:Uid="TabGroupNewTabButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnTabGroupNewTabClick"
                            Content="&#xE710;"
                            GotFocus="OnTabGroupNewTabGotFocus"
                            LostFocus="OnTabGroupNewTabLostFocus"
                            Opacity="0"
                            Style="{StaticResource TabRailIconButtonStyle}"
                            Visibility="{x:Bind CanOpenNewTab, Mode=OneWay}">
                        <Button.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.12" />
                        </Button.OpacityTransition>
                    </Button>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TabRailTabTemplate"
                      x:DataType="local:Tab">
            <!--
                One tab row. The title is what the rail is for, so it gets the
                width: nothing else claims any until it has something to say.
                The whole row carries one tooltip (RailTooltip) - the title
                TextBlock no longer runs its own, so the two can't fight.
            -->
            <Grid x:Name="RailRowRoot"
                  Padding="{x:Bind RailPadding, Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.Name="{x:Bind RailAccessibleName, Mode=OneWay}"
                  Background="Transparent"
                  ContextFlyout="{x:Bind TabViewItem.ContextFlyout, Mode=OneWay}"
                  PointerEntered="OnVerticalTabRowPointerEntered"
                  PointerExited="OnVerticalTabRowPointerExited"
                  ToolTipService.Placement="Right"
                  ToolTipService.ToolTip="{x:Bind RailTooltip, Mode=OneWay}">
                <!--
                    No ColumnSpacing: a Grid pads between its columns even when
                    a column's content is collapsed, which is exactly what used
                    to reserve room for status glyphs nobody was showing. The
                    gaps are margins on the children instead, and a collapsed
                    child contributes neither size nor margin.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="16"
                      Height="16"
                      VerticalAlignment="Center">
                    <mux:ProgressRing Width="15"
                                      Height="15"
                                      MinWidth="0"
                                      MinHeight="0"
                                      IsActive="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}"
                                      IsIndeterminate="{x:Bind TabStatus.IsProgressRingIndeterminate, Mode=OneWay}"
                                      Visibility="{x:Bind TabStatus.IsProgressRingActive, Mode=OneWay}"
                                      Value="{x:Bind TabStatus.ProgressValue, Mode=OneWay}" />
                    <IconSourceElement Width="16"
                                       Height="16"
                                       IconSource="{x:Bind mtu:IconPathConverter.IconSourceWUX(Icon), Mode=OneWay}"
                                       Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(TabStatus.IsProgressRingActive), Mode=OneWay}" />
                    <!--
                        The tab colour rides on the corner of the icon rather
                        than taking a column of its own: unset it is a fully
                        transparent brush, and it costs the title nothing.
                    -->
                    <Ellipse Width="6"
                             Height="6"
                             Margin="0,0,-1,-1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Fill="{x:Bind mtu:Converters.ColorToBrush(TabStatus.TabColorIndicator), Mode=OneWay}" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="1">
                    <TextBlock Style="{StaticResource TabRailTitleTextBlockStyle}"
                               Text="{x:Bind Title, Mode=OneWay}" />
                    <!--
                        Location, then the branch - bound apart so the path
                        reads as tertiary text and the branch reads as a
                        branch. The whole line goes away when there is neither:
                        RailMeta is empty exactly when both of them are.
                    -->
                    <Grid Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(RailMeta), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource TabRailMetaTextBlockStyle}"
                                   Text="{x:Bind RailPathText, Mode=OneWay}"
                                   Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(RailPathText), Mode=OneWay}" />
                        <!--
                            Segoe Fluent Icons and Segoe MDL2 Assets have no
                            branch or fork glyph (checked, codepoint by
                            codepoint, across E7xx-E9xx and F1xx-F2xx), so the
                            branch is told apart by weight of ink alone: its own
                            right-hand column and one notch less transparent
                            than the path beside it.
                        -->
                        <Border Grid.Column="1"
                                Margin="6,0,0,0"
                                Style="{StaticResource TabRailBranchPillStyle}"
                                Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(RailBranch), Mode=OneWay}">
                            <TextBlock Style="{StaticResource TabRailBranchTextBlockStyle}"
                                       Text="{x:Bind RailBranch, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </StackPanel>

                <!--
                    State. Each glyph is Collapsed when it is off, and a
                    collapsed element takes neither width nor margin, so a row
                    with nothing to report spends nothing on this column.
                -->
                <StackPanel x:Name="RailRowStatus"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <!--
                        Which agent is working in here. Deliberately the
                        quietest thing in the row: the meta opacity, no fill,
                        no badge - it answers a question you only ask when you
                        are already looking at the row.
                    -->
                    <FontIcon Margin="6,0,0,0"
                              AutomationProperties.Name="{x:Bind RailAgent, Mode=OneWay}"
                              Glyph="{x:Bind RailAgentGlyph, Mode=OneWay}"
                              Opacity="{ThemeResource TabRailMetaOpacity}"
                              Style="{StaticResource TabRailRowGlyphStyle}"
                              ToolTipService.ToolTip="{x:Bind RailAgent, Mode=OneWay}"
                              Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(RailAgentGlyph), Mode=OneWay}" />
                    <FontIcon Margin="6,0,0,0"
                              Glyph="&#xEA8F;"
                              Style="{StaticResource TabRailRowGlyphStyle}"
                              Visibility="{x:Bind TabStatus.BellIndicator, Mode=OneWay}" />
                    <FontIcon Margin="6,0,0,0"
                              Glyph="&#xE8A3;"
                              Style="{StaticResource TabRailRowGlyphStyle}"
                              Visibility="{x:Bind TabStatus.IsPaneZoomed, Mode=OneWay}" />
                    <FontIcon Margin="6,0,0,0"
                              Glyph="&#xE72E;"
                              Style="{StaticResource TabRailRowGlyphStyle}"
                              Visibility="{x:Bind TabStatus.IsReadOnlyActive, Mode=OneWay}" />
                    <FontIcon Margin="6,0,0,0"
                              Glyph="&#xEC05;"
                              Style="{StaticResource TabRailRowGlyphStyle}"
                              Visibility="{x:Bind TabStatus.IsInputBroadcastActive, Mode=OneWay}" />
                </StackPanel>

                <!--
                    Row actions. Opacity only, never Visibility: the column
                    keeps its width so a click at the row's edge can never land
                    on an invisible close button, and the fade stays a pure
                    state change with no reflow. TabRowControl raises it for the
                    hovered row, the selected row and the row holding keyboard
                    focus.
                -->
                <StackPanel x:Name="RailRowActions"
                            Grid.Column="3"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Opacity="0"
                            Orientation="Horizontal">
                    <StackPanel.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.1" />
                    </StackPanel.OpacityTransition>
                    <Button x:Uid="VerticalTabCloseButton"
                            Click="OnVerticalTabCloseClick"
                            Content="&#xE711;"
                            Style="{StaticResource TabRailRowActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:TabRailItemTemplateSelector x:Key="TabRailItemTemplateSelector"
                                           GroupHeaderTemplate="{StaticResource TabRailGroupHeaderTemplate}"
                                           TabTemplate="{StaticResource TabRailTabTemplate}" />
        <local:TabRailItemStyleSelector x:Key="TabRailItemStyleSelector"
                                        GroupHeaderStyle="{StaticResource TabRailHeaderContainerStyle}"
                                        TabStyle="{StaticResource TabRailRowContainerStyle}" />
    </ContentPresenter.Resources>

    <Grid x:Name="VerticalTabRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Search. The action beside it is transparent until touched - filled
            rectangles used to compete with the data underneath them. There is
            deliberately no second one: another button would cost the query
            32px in a 232px rail, and sections already fold one at a time from
            their own headers. The elevation shield rides in this row rather
            than a row of its own, which is worth a column here: on its own row
            it pushed the whole list down by a line for the entire session.
        -->
        <Grid Grid.Row="0"
              Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <!--
                    The magnifier and the clear button sit inside the field, so
                    this Padding overrides TabRailSearchBoxStyle's to leave them
                    room. It is the one metric in the rail that a token cannot
                    express, because it depends on those two glyphs.
                -->
                <TextBox x:Name="VerticalTabSearchBox"
                         x:Uid="VerticalTabSearchBox"
                         Padding="28,4,28,6"
                         IsSpellCheckEnabled="False"
                         KeyDown="OnVerticalTabSearchKeyDown"
                         Style="{StaticResource TabRailSearchBoxStyle}"
                         TextChanged="OnVerticalTabSearchTextChanged">
                    <TextBox.ContextFlyout>
                        <mtu:TextMenuFlyout />
                    </TextBox.ContextFlyout>
                </TextBox>

                <FontIcon Margin="9,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw"
                          Glyph="&#xE721;"
                          IsHitTestVisible="False"
                          Opacity="{ThemeResource TabRailMetaOpacity}"
                          Style="{StaticResource TabRailRowGlyphStyle}" />

                <!--  TabRowControl shows this only while there is something to clear.  -->
                <Button x:Name="VerticalTabSearchClearButton"
                        x:Uid="VerticalTabSearchClearButton"
                        Margin="0,0,3,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OnVerticalTabSearchClearClick"
                        Content="&#xE711;"
                        Style="{StaticResource TabRailRowActionButtonStyle}"
                        Visibility="Collapsed" />
            </Grid>

            <!--  EA18 is the "Shield" glyph  -->
            <FontIcon x:Uid="ElevationShield"
                      Grid.Column="1"
                      Margin="6,0,2,0"
                      VerticalAlignment="Center"
                      Glyph="&#xEA18;"
                      Opacity="{ThemeResource TabRailMetaOpacity}"
                      Style="{StaticResource TabRailRowGlyphStyle}"
                      Visibility="{x:Bind ShowElevationShield, Mode=OneWay}" />

            <ToggleButton x:Name="RecentSortToggle"
                          x:Uid="RecentSortToggle"
                          Grid.Column="2"
                          Margin="2,0,0,0"
                          Checked="OnRecentSortToggleChecked"
                          Content="&#xE81C;"
                          Style="{StaticResource TabRailIconToggleButtonStyle}"
                          Unchecked="OnRecentSortToggleUnchecked" />
        </Grid>

        <!--
            The workspace button is collapsed; it exists as the anchor
            WorkspaceFlyout is shown at. The row is collapsed with it so an
            empty strip never reserves a line above the list - which is what
            the elevation shield used to do from here.
        -->
        <StackPanel Grid.Row="1"
                    Margin="8,0,8,4"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="Collapsed">
            <!--  Workspace/windows button  -->
            <Button x:Name="WorkspaceDropdown"
                    x:Uid="WorkspaceDropdown"
                    Style="{StaticResource TabRailSectionHeaderButtonStyle}"
                    Visibility="Collapsed">
                <Button.Content>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <!--  EE40 is the "TaskViewSettings" glyph  -->
                        <FontIcon Glyph="&#xEE40;"
                                  Style="{StaticResource TabRailRowGlyphStyle}" />
                        <TextBlock x:Name="WorkspaceNameText"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource TabRailSectionNameTextBlockStyle}"
                                   Text="{x:Bind WorkspaceName, Mode=OneWay}"
                                   Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(WorkspaceName), Mode=OneWay}" />
                    </StackPanel>
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout x:Name="WorkspaceFlyout" />
                </Button.Flyout>
            </Button>
        </StackPanel>

        <ListView x:Name="VerticalTabList"
                  Grid.Row="2"
                  Padding="4,0,4,4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  AllowDrop="{x:Bind CanReorderVerticalTabs, Mode=OneWay}"
                  CanDragItems="{x:Bind CanReorderVerticalTabs, Mode=OneWay}"
                  CanReorderItems="{x:Bind CanReorderVerticalTabs, Mode=OneWay}"
                  DragItemsCompleted="OnVerticalTabDragItemsCompleted"
                  DragItemsStarting="OnVerticalTabDragItemsStarting"
                  ItemContainerStyleSelector="{StaticResource TabRailItemStyleSelector}"
                  ItemTemplateSelector="{StaticResource TabRailItemTemplateSelector}"
                  SelectionChanged="OnVerticalTabSelectionChanged"
                  SelectionMode="Single">
            <!--  No item transitions. The rail regroups itself whenever a tab
                  changes directory, project or section, and animating rows in,
                  out and past each other for that turns a data update into a
                  visible lurch - especially with the list rebuilt behind a
                  window that just took focus. Selection and hover still
                  animate; only the reflow is immediate.  -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
        </ListView>

        <!--
            A query that matches nothing says so instead of leaving the rail
            blank. TabRowControl reveals this panel and rewrites
            VerticalTabEmptyStateText with the query that found nothing; the
            x:Uid on it is the fallback that shows if that string is missing.
        -->
        <StackPanel x:Name="VerticalTabEmptyState"
                    Grid.Row="2"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
            <TextBlock x:Name="VerticalTabEmptyStateText"
                       x:Uid="VerticalTabEmptyStateText"
                       Style="{StaticResource TabRailEmptyStateTextBlockStyle}" />
            <TextBlock x:Uid="VerticalTabEmptyStateHint"
                       Style="{StaticResource TabRailEmptyStateHintTextBlockStyle}" />
            <Button x:Uid="VerticalTabEmptyStateClearButton"
                    HorizontalAlignment="Center"
                    Click="OnVerticalTabSearchClearClick"
                    Style="{StaticResource TabRailSectionHeaderButtonStyle}" />
        </StackPanel>

        <Grid Grid.Row="3">
            <!--
                The same hairline the sections use, run edge to edge: this one
                separates two regions of the rail rather than two sections of a
                list, so it overrides the style's inset.
            -->
            <Border Margin="0"
                    VerticalAlignment="Top"
                    Style="{StaticResource TabRailDividerStyle}" />

            <Grid Margin="8,6,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <mux:SplitButton x:Name="NewTabButton"
                                 x:Uid="NewTabSplitButton"
                                 Grid.Column="0"
                                 Height="32"
                                 Padding="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Stretch"
                                 AllowDrop="True"
                                 AutomationProperties.AccessibilityView="Control"
                                 BorderThickness="0"
                                 Click="OnNewTabButtonClick"
                                 Content="&#xE710;"
                                 DragOver="OnNewTabButtonDragOver"
                                 Drop="OnNewTabButtonDrop"
                                 FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                 FontSize="{StaticResource TabRailGlyphFontSize}">
                    <ToolTipService.ToolTip>
                        <ToolTip Placement="Mouse">
                            <TextBlock TextWrapping="Wrap">
                                <Run x:Uid="NewTabRun" /> <LineBreak />
                                <Run x:Uid="NewPaneRun"
                                     FontStyle="Italic" /> <LineBreak />
                                <Run x:Uid="NewWindowRun"
                                     FontStyle="Italic" />
                            </TextBlock>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <!--  U+E710 is the fancy plus icon.  -->
                    <mux:SplitButton.Resources>
                        <!--
                            The footer is one quiet strip: no fill and no border
                            until the button is touched, using the same chrome
                            ramp as the rail's icon buttons. The aliases have to
                            sit inside ThemeDictionaries - a StaticResource
                            resolves once, so a flat dictionary would freeze the
                            brush at whatever the theme was at parse time.
                            TerminalPage still writes these same keys directly
                            when a tab colour is applied to the new-tab button.
                            High contrast keeps the system's own chrome: a
                            borderless transparent button is an invisible one.
                        -->
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabRailChromeForegroundBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabRailChromePressedBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabRailChromeHoverForegroundBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabRailChromeHoverBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabRailChromeHoverForegroundBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundSecondary"
                                                    ResourceKey="TabRailChromeForegroundBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrush"
                                                    ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPointerOver"
                                                    ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPressed"
                                                    ResourceKey="ControlFillColorTransparentBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabRailChromeForegroundBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabRailChromePressedBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabRailChromeHoverForegroundBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabRailChromeHoverBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabRailChromeHoverForegroundBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundSecondary"
                                                    ResourceKey="TabRailChromeForegroundBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrush"
                                                    ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPointerOver"
                                                    ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPressed"
                                                    ResourceKey="ControlFillColorTransparentBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="TabViewButtonBackground" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabViewButtonForeground" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabViewButtonBackgroundPressed" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabViewButtonForegroundPressed" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabViewButtonBackgroundPointerOver" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabViewButtonForegroundPointerOver" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <x:Double x:Key="SplitButtonPrimaryButtonSize">31</x:Double>
                            <x:Double x:Key="SplitButtonSecondaryButtonSize">31</x:Double>
                        </ResourceDictionary>
                    </mux:SplitButton.Resources>
                </mux:SplitButton>

                <!--
                    Icon-only launchers for the first profiles that fit next to
                    the new tab split button. TerminalPage fills this panel from
                    the active profile list; FitNewTabProfileButtons collapses
                    the buttons that would overflow the rail, so nothing (and
                    especially not the dropdown chevron) renders clipped. Those
                    buttons are built in code, so TabRailFooterProfileButtonStyle
                    has to be applied there rather than here.
                -->
                <StackPanel x:Name="NewTabProfilesPanel"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            SizeChanged="OnNewTabProfilesPanelSizeChanged" />
            </Grid>
        </Grid>

        <mux:TabView x:Name="TabView"
                     Grid.Row="0"
                     AllowDropTabs="True"
                     CanDragTabs="True"
                     CanReorderTabs="True"
                     IsAddTabButtonVisible="false"
                     TabWidthMode="Equal"
